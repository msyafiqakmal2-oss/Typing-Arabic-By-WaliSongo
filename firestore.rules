rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Satu dokumen per siswa. Siapa pun boleh membaca (untuk klasemen); penulisan dibatasi bentuk dan ukurannya.
    match /students/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['name','points','rank','wpm','acc','streak','days','updated','data'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.points is int && request.resource.data.points >= 0 && request.resource.data.points <= 1000000
        && request.resource.data.data is string && request.resource.data.data.size() < 400000
        && id.size() <= 60;
      allow delete: if false;
    }
  }
}
